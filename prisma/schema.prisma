// Prisma schema for the AI Life Services Platform
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ────────────────────────────────────────────────────────────────────────────
// Enums
// ────────────────────────────────────────────────────────────────────────────

enum Role {
  USER
  PROVIDER
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ReminderRepeat {
  NONE
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  ONLINE
  CASH
  PARTIAL
}

// Whether a business sells time-based services (appointments) or physical
// goods (a store/catalog with product orders).
enum BusinessType {
  SERVICE
  STORE
}

// Lifecycle of a product order (pickup). Mirrors BookingStatus but for goods.
enum OrderStatus {
  PENDING
  CONFIRMED
  READY
  COMPLETED
  CANCELLED
}

// ────────────────────────────────────────────────────────────────────────────
// Models
// ────────────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String
  phone        String?
  passwordHash String
  fullName     String
  role         Role     @default(USER)
  avatarUrl    String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // A provider user can own multiple businesses.
  providers Provider[]
  // Bookings this user has made as a customer.
  bookings  Booking[]
  // Product orders this user has placed as a customer.
  orders    Order[]
  // The user's saved shopping cart (persists across sessions).
  cartItems CartItem[]
  // Reviews this user has written.
  reviews   Review[]
  // Personal reminders (renewals, follow-ups, etc.).
  reminders Reminder[]

  // Accounts are per-audience: the same email can exist once as a customer
  // (USER) and once as a business (PROVIDER) — two independent accounts.
  @@unique([email, role])
  @@index([role])
}

model Category {
  id          String   @id @default(cuid())
  // e.g. "medical", "salon", "fitness"
  slug        String   @unique
  name        String
  description String?
  iconUrl     String?
  // Whether this category is for service (appointment) or store (product) businesses.
  type        BusinessType @default(SERVICE)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  providers     Provider[]
  services      Service[]
  subcategories Subcategory[]

  @@index([isActive])
}

model Subcategory {
  id          String   @id @default(cuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  // e.g. "dentist", "general-physician", "plumber"
  slug        String   @unique
  name        String
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  providers Provider[]

  @@index([categoryId])
  @@index([isActive])
}

model Provider {
  id          String   @id @default(cuid())
  // The user account that owns/manages this business (a user can own many).
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId    String
  category      Category     @relation(fields: [categoryId], references: [id])
  // The specific business type within the category (e.g. Dentist under Healthcare).
  subcategoryId String?
  subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id])

  // Time-based services (appointments) vs a goods store (product orders).
  type          BusinessType @default(SERVICE)

  businessName String
  description  String?
  phone        String
  email        String?

  // Location (PostGIS can be added later for geo-radius queries).
  addressLine  String?
  city         String?
  state        String?
  postalCode   String?
  latitude     Float?
  longitude    Float?

  // Business gallery image URLs (first one acts as the cover).
  images       String[] @default([])

  ratingAvg    Float    @default(0)
  ratingCount  Int      @default(0)
  // % of the total a customer must pay up front for a "partial" booking (0 = off).
  depositPercent Int    @default(0)
  isVerified   Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  services      Service[]
  bookings      Booking[]
  businessHours BusinessHour[]
  dateHours     BusinessDateHour[]
  reviews       Review[]
  // Catalog + orders (only used when type = STORE).
  products      Product[]
  orders        Order[]

  @@index([userId])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([city])
  @@index([isActive])
}

model BusinessHour {
  id         String   @id @default(cuid())
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  dayOfWeek  Int      // 0 = Sunday ... 6 = Saturday
  isOpen     Boolean  @default(true)
  openTime   String   @default("09:00") // "HH:MM" 24-hour
  closeTime  String   @default("18:00")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([providerId, dayOfWeek])
  @@index([providerId])
}

// Date-specific opening hours that override the weekly BusinessHour for one day
// (e.g. a holiday closure or special extended hours on a particular date).
model BusinessDateHour {
  id         String   @id @default(cuid())
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date // the specific calendar date (no time component)
  isOpen     Boolean  @default(true)
  openTime   String   @default("09:00") // "HH:MM" 24-hour
  closeTime  String   @default("18:00")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([providerId, date])
  @@index([providerId])
}

model Service {
  id            String   @id @default(cuid())
  providerId    String
  provider      Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id])

  name          String
  description   String?
  // Price stored in the smallest currency unit (e.g. paise/cents) to avoid float errors.
  priceMinor    Int
  currency      String   @default("INR")
  durationMin   Int      @default(30)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bookings Booking[]

  @@index([providerId])
  @@index([categoryId])
}

model Booking {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  providerId  String
  provider    Provider      @relation(fields: [providerId], references: [id])
  serviceId   String
  service     Service       @relation(fields: [serviceId], references: [id])

  startTime   DateTime
  endTime     DateTime
  status      BookingStatus @default(PENDING)
  notes       String?
  // Reason a provider gives when they cancel — shown to the customer.
  cancelReason String?

  // Payment (Razorpay).
  amountMinor     Int?
  amountPaidMinor Int           @default(0) // paid so far (deposit or full)
  currency        String?
  paymentMethod   PaymentMethod @default(ONLINE)
  paymentStatus   PaymentStatus @default(PENDING)
  razorpayOrderId String? // payment-link / order id
  paymentRef      String? // razorpay payment id once paid

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  review      Review?

  @@index([userId])
  @@index([providerId])
  @@index([status])
  // Prevents the exact same provider slot from being double-booked.
  @@unique([providerId, startTime])
}

// A customer's personal reminder — a manual renewal/service (car insurance,
// bike service, warranty…) or a follow-up to a booking. `repeat` rolls the due
// date forward when marked done; `providerId` optionally links a business.
model Reminder {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  // Free-form category: vehicle | insurance | health | document | home | appointment | other
  type             String         @default("other")
  // dueDate = the next occurrence we remind on (the start date, rolled forward).
  dueDate          DateTime
  // Optional cap: a repeating reminder stops after this date.
  endDate          DateTime?
  repeat           ReminderRepeat @default(NONE)
  remindDaysBefore Int            @default(1)
  note             String?
  providerId       String?
  completedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([userId])
}

// A customer's review of a completed booking. One review per booking.
model Review {
  id         String   @id @default(cuid())
  bookingId  String   @unique
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  rating     Int // 1..5
  comment    String?
  createdAt  DateTime @default(now())

  @@index([providerId])
  @@index([userId])
}

// A sellable item in a STORE business's catalog (grains, soap, shampoo…).
// The equivalent of a Service, but priced per unit with tracked stock.
model Product {
  id          String   @id @default(cuid())
  providerId  String
  provider    Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  name        String
  description String?
  // What the product is measured in: "weight" (base gram), "volume" (base ml)
  // or "count" (base piece). All quantities below are in that base unit.
  measure     String   @default("count")
  // Price (paise) for `priceQty` base units. e.g. ₹200 / 100 g →
  // priceMinor = 20000, priceQty = 100, measure = "weight".
  priceMinor  Int
  priceQty    Float    @default(1)
  currency    String   @default("INR")
  // A base-unit label kept for display/back-compat ("g", "ml", "piece"…).
  unit        String   @default("piece")
  // Tracked inventory in base units (e.g. 15 kg → 15000).
  stockQty    Float    @default(0)
  // Minimum order + step increment, in base units (e.g. 100 g → 100).
  stepQty     Float    @default(1)
  // Storefront grouping / aisle, e.g. "Grains", "Toiletries" (for section rows).
  section     String?
  imageUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems  OrderItem[]
  cartItems   CartItem[]

  @@index([providerId])
}

// A line in a customer's persistent shopping cart. quantity is in base units.
model CartItem {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([userId])
}

// A customer's product order from a STORE business (pickup). No time slot —
// reuses the same payment fields as Booking so payments work identically.
model Order {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  providerId  String
  provider    Provider    @relation(fields: [providerId], references: [id])

  status      OrderStatus @default(PENDING)
  note        String?

  amountMinor     Int
  amountPaidMinor Int           @default(0)
  currency        String        @default("INR")
  paymentMethod   PaymentMethod @default(ONLINE)
  paymentStatus   PaymentStatus @default(PENDING)
  razorpayOrderId String?
  paymentRef      String?

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  items       OrderItem[]

  @@index([userId])
  @@index([providerId])
  @@index([status])
}

// A line in an order. Name/price/unit are snapshotted so past orders stay
// accurate even if the product later changes or is removed.
model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String?
  product    Product? @relation(fields: [productId], references: [id])

  name       String
  measure    String   @default("count")
  priceMinor Int      // price for `priceQty` base units
  priceQty   Float    @default(1)
  unit       String   @default("piece")
  // Amount ordered, in base units (e.g. 300 g → 300).
  quantity   Float

  @@index([orderId])
}
