{
  "name": "dnx-backend",
  "version": "0.1.0",
  "description": "AI Life Services Platform - Backend API (Node + Express + TypeScript + Prisma + PostgreSQL)",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/server.ts",
    "dev:staging": "NODE_ENV=staging ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/server.ts",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "NODE_ENV=production node dist/server.js",
    "start:production": "NODE_ENV=production node dist/server.js",
    "start:staging": "NODE_ENV=staging node dist/server.js",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json --noEmit",
    "prisma:generate": "dotenv -e .env.development -- prisma generate",
    "prisma:migrate": "dotenv -e .env.development -- prisma migrate dev",
    "prisma:migrate:staging": "dotenv -e .env.staging -- prisma migrate deploy",
    "prisma:migrate:production": "dotenv -e .env.production -- prisma migrate deploy",
    "prisma:studio": "dotenv -e .env.development -- prisma studio",
    "prisma:studio:staging": "dotenv -e .env.staging -- prisma studio",
    "prisma:studio:production": "dotenv -e .env.production -- prisma studio",
    "prisma:seed": "dotenv -e .env.development -- ts-node-dev --transpile-only prisma/seed.ts",
    "create-admin": "ts-node-dev --transpile-only -r tsconfig-paths/register scripts/createAdmin.ts",
    "create-admin:staging": "NODE_ENV=staging ts-node-dev --transpile-only -r tsconfig-paths/register scripts/createAdmin.ts",
    "create-admin:production": "NODE_ENV=production ts-node-dev --transpile-only -r tsconfig-paths/register scripts/createAdmin.ts",
    "set-category-icons": "ts-node-dev --transpile-only -r tsconfig-paths/register scripts/setCategoryIcons.ts",
    "set-product-type-icons": "ts-node-dev --transpile-only -r tsconfig-paths/register scripts/setProductTypeIcons.ts",
    "set-category-popularity": "ts-node-dev --transpile-only -r tsconfig-paths/register scripts/setCategoryPopularity.ts",
    "set-product-type-popularity": "ts-node-dev --transpile-only -r tsconfig-paths/register scripts/setProductTypePopularity.ts"
  },
  "prisma": {
    "seed": "ts-node-dev --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "razorpay": "^2.9.8",
    "resend": "^6.30.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "dotenv-cli": "^7.4.4",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "prisma": "^5.22.0",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  }
}
