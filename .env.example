# This project uses THREE environment files instead of a single `.env`:
#   .env.development   (npm run dev            → loaded when NODE_ENV=development, the default)
#   .env.staging        (npm run dev:staging    → loaded when NODE_ENV=staging)
#   .env.production     (npm run start          → loaded when NODE_ENV=production)
# Copy this file to each of the three above and fill in values per environment.
# All three are gitignored — only this template is committed.

# ── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed origins (the matching web env's dev + preview ports)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ── Database (PostgreSQL) ───────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
# Use a DIFFERENT DBNAME per environment (e.g. dnx, dnx_staging, dnx_prod) so
# dev/QA/production data never mix, even on the same local Postgres instance.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dnx?schema=public

# ── Auth (JWT) ──────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── Phase 2 (leave blank for now) ───────────────────────────────────────────
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# GOOGLE_MAPS_API_KEY=

# ── Email (Resend) — powers "forgot password" reset codes ───────────────────
# Sign up at resend.com, verify a sending domain (or use their shared
# onboarding@resend.dev sender for testing), then paste the API key below.
# Without this set, reset emails are skipped (logged to the console instead).
# RESEND_API_KEY=
EMAIL_FROM=DNX <onboarding@resend.dev>
